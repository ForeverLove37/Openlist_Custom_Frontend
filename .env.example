# Published custom frontend image
DRIVE_IMAGE=ghcr.io/foreverlove37/openlist-custom-frontend
DRIVE_TAG=latest

# Host and container ports are independent. Keep bind addresses loopback-only
# when a host HTTPS reverse proxy is in front of the services.
DRIVE_BIND_IP=127.0.0.1
DRIVE_PORT=8080
DRIVE_CONTAINER_PORT=8080
TZ=Etc/UTC

# Full-stack compose.yml settings
OPENLIST_VERSION=v4.2.2
OPENLIST_UID=0
OPENLIST_GID=0
OPENLIST_UMASK=022
OPENLIST_BIND_IP=127.0.0.1
OPENLIST_HOST_PORT=5244
OPENLIST_LISTEN_ADDRESS=0.0.0.0
OPENLIST_HTTP_PORT=5244
OPENLIST_HTTPS_PORT=-1

# compose.existing.yml setting
OPENLIST_URL=http://127.0.0.1:5244

# Thumbnail and short-lived BFF session settings (milliseconds/bytes)
THUMBNAIL_CACHE_TTL_MS=86400000
THUMBNAIL_SESSION_TTL_MS=1800000
THUMBNAIL_MAX_REDIRECTS=5
THUMBNAIL_VIDEO_SOURCE_MAX_BYTES=268435456

# Dedicated remote Android build and APK download service
ANDROID_BUILD_SERVICE_URL=https://dl-chatapp.zengjunjie.com
ANDROID_BUILD_SERVICE_TOKEN=replace-with-a-long-random-token
ANDROID_DOWNLOAD_BASE_URL=https://dl-chatapp.zengjunjie.com
